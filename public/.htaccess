RewriteEngine On
RewriteBase /

# Shared Hostinger: PHP under /api/*.php is the live API (no Go proxy).
# Existing files must not be rewritten to the SPA.
RewriteRule \.php$ - [L]
RewriteRule ^index\.html$ - [L]

# Career applications are private — Admin/HR JWT download only.
RewriteRule ^uploads/careers(/|$) - [F,L]

# Partner hotel photos at /uploads/... must stay same-origin, never the SPA.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/ - [L]
RewriteRule ^uploads/(.+)$ media.php?path=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
