# ============================================================
# YLT Travels — Transit OS Backend Environment Variables
# Copy to .env and fill in real values. No hardcoded secrets.
# ============================================================

# --- HTTP ---
PORT=8080

# --- Database ---
# Option A: Full connection string (recommended)
# Format: user:pass@tcp(host:port)/dbname?parseTime=true
DATABASE_URL=

# Option B: Individual fields (used when DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=u377962510_ylt_travels

# Connection pool limits
DB_MAX_OPEN_CONNS=80
DB_MAX_IDLE_CONNS=40
DB_CONN_MAX_LIFETIME=10m
DB_CONN_MAX_IDLE_TIME=5m

# --- JWT Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=ylttravels.com
JWT_TTL=168h
REFRESH_TTL=720h

# --- Core Admin (legacy fallback) ---
CORE_ADMIN_USER=CoreAdmin
CORE_ADMIN_PASS=change-me

# --- GDS Supplier API Keys ---
GDS_BITLA_KEY=
GDS_MANTIS_KEY=
GDS_ABHIBUS_KEY=

# --- File Uploads (local disk now, S3 later) ---
FILE_STORAGE_PATH=/var/www/ylttravels/uploads
MAX_UPLOAD_BYTES=8388608

# --- CORS ---
CORS_ORIGIN=*

# --- SMTP (email sending) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ylttravels.com
SMTP_SECURE=true
