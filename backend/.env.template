# ============================================================
# YLT Travels — Transit OS Backend Environment Variables
# Copy to .env on the VPS. Env vars always override Go fallbacks.
# Never put these in Vite / VITE_* / the browser bundle.
# ============================================================

# --- HTTP ---
PORT=8080

# --- Database ---
# Prefer DATABASE_URL, then MYSQL_DSN. Encode @ in the password as %40.
# Shape: u377962510_admin:PASSWORD@tcp(localhost:3306)/u377962510_YLT_Travels?parseTime=true
DATABASE_URL=u377962510_admin:YOUR_PASSWORD@tcp(localhost:3306)/u377962510_YLT_Travels?parseTime=true&multiStatements=true&charset=utf8mb4
MYSQL_DSN=

DB_HOST=localhost
DB_PORT=3306
DB_USER=u377962510_admin
DB_PASSWORD=YOUR_PASSWORD
DB_PASS=YOUR_PASSWORD
DB_NAME=u377962510_YLT_Travels
DB_CHARSET=utf8mb4

# Connection pool limits
DB_MAX_OPEN_CONNS=80
DB_MAX_IDLE_CONNS=40
DB_CONN_MAX_LIFETIME=10m
DB_CONN_MAX_IDLE_TIME=5m

# --- JWT Auth ---
JWT_SECRET=ylt-travels-hostinger-secret-change-me-2026
JWT_ISSUER=ylttravels.com
JWT_TTL=168h
JWT_TTL_HOURS=168
REFRESH_TTL=720h

# --- Core Admin ---
CORE_ADMIN_USER=CoreAdmin
CORE_ADMIN_PASS=YOUR_PASSWORD

# Local/dev only: include OTP code in JSON when SMTP is off. Never enable on live.
OTP_DEV=0

# --- GDS Supplier API Keys ---
GDS_BITLA_KEY=
GDS_MANTIS_KEY=
GDS_ABHIBUS_KEY=

# --- File Uploads ---
FILE_STORAGE_PATH=/var/www/ylttravels/uploads
MAX_UPLOAD_BYTES=8388608

# --- CORS ---
CORS_ORIGIN=*

# --- SMTP (email OTP — no SMS subscription) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ylttravels.com
SMTP_SECURE=true
