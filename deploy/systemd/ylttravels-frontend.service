[Unit]
Description=YLT Travels static preview (optional). Prefer nginx serving dist/ and proxying /api to ylt-api.

[Service]
Type=simple
User=ylt
Group=ylt
WorkingDirectory=/var/www/ylttravels
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx --yes vite preview --host 127.0.0.1 --port 4173 --outDir dist
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
