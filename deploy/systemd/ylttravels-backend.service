[Unit]
Description=YLT Travels Go Backend (transit-os)
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=ylt
Group=ylt
WorkingDirectory=/var/www/ylttravels/backend
EnvironmentFile=/var/www/ylttravels/.env
ExecStart=/var/www/ylttravels/backend/ylt-api
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ylttravels-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/ylttravels/uploads
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
